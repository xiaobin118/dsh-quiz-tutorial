{
  "name": "dsh-quiz-tutorial",
  "version": "1.0.3",
  "private": false,
  "description": "刷题场：把复习内容变成题集，题目旁给逐步手算解析，错题自动进错题本；支持 /skill 出题与题集删除/隐藏。",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "client/src/*.js",
    "cordis.patch.yml",
    "docs/screenshots/*.png",
    "docs/deck-format.md",
    "icon.png",
    "icon.svg",
    "index.js",
    "locale/*.json",
    "skill.md",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "tools/build_client.mjs",
    "test/*.js",
    "test/*.mjs",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "author": "karliar (xiaobin118)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaobin118/dsh-quiz-tutorial.git"
  },
  "homepage": "https://github.com/xiaobin118/dsh-quiz-tutorial#readme",
  "bugs": {
    "url": "https://github.com/xiaobin118/dsh-quiz-tutorial/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "quiz",
    "exam",
    "flashcards",
    "review",
    "education"
  ],
  "scripts": {
    "build:client": "node tools/build_client.mjs",
    "check": "node --check index.js && node --check client.js && node tools/build_client.mjs --check",
    "pretest": "node tools/build_client.mjs --check",
    "test": "node --test \"test/**/*.test.js\"",
    "verify": "npm run check && npm test"
  },
  "publishConfig": {
    "access": "public"
  }
}
